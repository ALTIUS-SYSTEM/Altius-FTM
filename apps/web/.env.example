# Live API base URL. Required for Keycloak sign-in (API adapter).
# Local docker-compose API: http://127.0.0.1:8080
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# Keycloak public URL for the web PKCE login flow.
# Local docker-compose Keycloak: http://127.0.0.1:8081
NEXT_PUBLIC_KEYCLOAK_URL=http://127.0.0.1:8081
NEXT_PUBLIC_KEYCLOAK_REALM=altius
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=altius-web

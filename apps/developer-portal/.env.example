# Origin of the Altius web dashboard (apps/web).
# Portal header CTA deep-links here for sign-in; OAuth/PKCE starts on the web origin.
NEXT_PUBLIC_WEB_APP_URL=http://127.0.0.1:3000

# API base shown in Scalar “Try it” / server hints (no trailing slash required).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# Customer support mailbox shown in the portal footer (mailto).
# No public address is committed in-repo; set this for staging/production.
# Example: NEXT_PUBLIC_SUPPORT_EMAIL=support@your-company.example
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Altius FTM — root compose environment.
#
#   cp .env.example .env      # then fill in every CHANGE-ME below
#
# `docker compose` reads this file automatically. Every value here is already
# defaulted in docker-compose.yml for local development, so an empty .env still
# brings the local stack up. The defaults are NOT safe for a public host — the
# CHANGE-ME markers are the ones that must not ship as-is.
#
# Never commit .env (.gitignore already excludes it).
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. Public identity — the domain everything is derived from
# ===========================================================================

# Public hostname served by Caddy. Set it and Caddy provisions Let's Encrypt
# TLS automatically. Leave it empty and compose substitutes an inert placeholder
# (`http://localhost.invalid`) so only the plain `:80` block answers — local dev
# and bare-IP staging. Do not put a scheme or a path here, just the hostname.
#
# DNS must already point at this VPS before first start — Caddy fails the
# ACME challenge otherwise and retries with backoff.
ALTIUS_DOMAIN=

# Browser origin of the operations dashboard (apps/web). On Vercel that is the
# Vercel domain, NOT this host. Required by docker-compose.prod.yml: it is
# substituted into the realm's redirect URIs and web origins when Keycloak
# imports the realm on first boot, and a mismatch shows up as "invalid
# redirect" at login. Keep CORS_ORIGINS below in step with it.
ALTIUS_WEB_ORIGIN=https://app.example.com

# ===========================================================================
# 2. Secrets — generate fresh, never reuse across environments
# ===========================================================================
# Generate each with:  openssl rand -hex 32

# Postgres superuser password for the bundled `postgres` service.
POSTGRES_USER=altius
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=altius

# ⚠ DATABASE_URL does NOT inherit POSTGRES_PASSWORD.
# docker-compose.yml falls back to a literal `postgres://altius:altius@…`, so
# changing POSTGRES_PASSWORD without also rewriting this line leaves the API
# authenticating with the old password and crash-looping on startup.
# Keep the credentials here identical to POSTGRES_USER / POSTGRES_PASSWORD.
#
# Bundled compose Postgres (same private network, cleartext is fine):
DATABASE_URL=postgres://altius:CHANGE-ME@postgres:5432/altius?sslmode=disable
# Managed/off-host Postgres — TLS is mandatory once traffic leaves the host:
# DATABASE_URL=postgres://user:pass@db.example.com:5432/altius?sslmode=require

# Keycloak bootstrap admin (console user, created on first start only).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE-ME

# Signs server-owned agent conversation state. Absent = agent resume refuses.
AGENT_STATE_SECRET=CHANGE-ME

# Confidential client secret for `altius-api`, if you convert it from
# bearer-only to a confidential client. Empty is correct for the shipped realm.
KEYCLOAK_CLIENT_SECRET=

# ===========================================================================
# 3. Keycloak wiring
# ===========================================================================

# Issuer as the BROWSER sees it — this is what lands in the JWT `iss` claim and
# what the API validates against. Behind Caddy it is the public HTTPS URL.
# Local:      http://localhost:8081/realms/altius
# Production: https://${ALTIUS_DOMAIN}/realms/altius
KEYCLOAK_ISSUER=http://localhost:8081/realms/altius

# Internal container routes. The API resolves these over the compose network,
# so they stay http:// and bypass the edge — leave them alone unless Keycloak
# moves off this host.
KEYCLOAK_JWKS_URL=http://keycloak:8081/realms/altius/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://keycloak:8081/realms/altius/protocol/openid-connect/token

# Must match the audience mapper on altius-web / altius-mobile.
KEYCLOAK_AUDIENCE=altius-api
KEYCLOAK_CLIENT_ID=altius-api

# Must match the web app's PKCE redirect exactly (`${origin}/callback`) AND the
# Valid Redirect URIs registered on the `altius-web` client in Keycloak.
KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback
KEYCLOAK_LOGOUT_REDIRECT_URI=http://localhost:3000

# Keycloak's own persistence. Postgres in every environment: it gets its own
# database (created by deploy/postgres/10-keycloak-db.sh) so its Liquibase
# migrations never meet the API's. The old `dev-file` (H2) default did not work
# — the H2 driver rejected the postgres JDBC URL compose passed alongside it —
# and wrote to a path with no volume, losing the realm on every recreate.
# Leave these unset unless Keycloak points at a database outside this stack.
# KC_DB=postgres
# KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
# KC_DB_USERNAME and KC_DB_PASSWORD default to POSTGRES_USER / POSTGRES_PASSWORD.

# Caddy terminates TLS, so Keycloak must trust X-Forwarded-* to emit https://
# issuer and redirect URLs. Leave as-is when running behind the bundled edge.
KC_PROXY_HEADERS=xforwarded

# Keycloak Admin service account — enables user provisioning from the API.
# Absent = the admin/provisioning endpoints refuse rather than half-work.
# Create a confidential client with the `realm-management` service-account
# roles, then fill these in.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8081
KEYCLOAK_ADMIN_REALM=altius

# ===========================================================================
# 4. API
# ===========================================================================

# `postgres` (transactional source of truth) or `typedb` (legacy graph path).
STORE_BACKEND=postgres

# Comma-separated browser origins allowed to call the API. EMPTY DENIES ALL
# cross-origin calls — with web/landing on Vercel this must list those origins
# or the dashboard cannot reach the API at all.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Resource-owner password grant. Keep false: it bypasses PKCE and hands the
# API long-lived user credentials. Only ever true behind a private frontend.
ALLOW_PASSWORD_GRANT=false

RUST_LOG=info
# `json` for log shippers, `text` for a developer terminal.
LOG_FORMAT=json

# Bootstrap tenant, created on first start if absent.
DEFAULT_ORG_ID=altius
DEFAULT_ORG_NAME=Altius
DEFAULT_HUB_ID=jakarta
DEFAULT_HUB_NAME=Jakarta
# Keycloak `sub` of the user promoted to org admin on first boot — a UUID, not
# a username. Find it in the Keycloak admin console under Users -> the user ->
# ID. A username here matches no JWT and leaves that admin with 403 on every
# business endpoint. The value below is the pinned local dev admin.
DEFAULT_ADMIN_SUB=11111111-1111-4111-8111-111111111111

# ===========================================================================
# 5. Web / landing build args
# ===========================================================================
# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time. Changing any
# of these needs `docker compose build web`, not `restart` — a rebuilt value
# never reaches an already-built image.
#
# Only used when web/landing run from this compose file. If they are deployed
# to Vercel, set the same names in the Vercel project instead.

NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=altius
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=altius-web
# Browser-reachable dashboard origin used by landing CTAs — a host origin,
# never the `web` compose service name.
NEXT_PUBLIC_WEB_APP_URL=http://127.0.0.1:3000

# ===========================================================================
# 6. Optional integrations — every one is off until its key is present
# ===========================================================================

# Maps. Absent key = offline solver and schematic (non-Google) static maps.
# The key stays server-side; clients get a backend-proxied map.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTE_MODE=directions

# LLM dispatch agent. Absent key = agent endpoints refuse.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# SMS / WhatsApp gateway. Absent token = notify endpoints refuse.
NOTIFY_TOKEN=
NOTIFY_SMS_URL=
NOTIFY_WHATSAPP_URL=
NOTIFY_SENDER=

# McEasy VSMS/TMS worker. Absent key = the worker does not start.
MCEASY_API_KEY=
MCEASY_BASE_URL=https://vsms-v2-public.mceasy.com
MCEASY_POLL_SECONDS=60
MCEASY_MASTER_SYNC_SECONDS=3600
MCEASY_RETENTION_HOURS=72

# How long device_events are kept before the retention sweep removes them.
EVENTS_RETENTION_DAYS=90

# FCM v1 push. The credentials path is resolved INSIDE the container, so the
# service-account JSON has to be bind-mounted as well — the variable alone is
# not enough and push registration keeps refusing.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# TypeDB — only read when STORE_BACKEND=typedb.
TYPEDB_ADDRESS=typedb:1729
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=CHANGE-ME-IF-USED
TYPEDB_DATABASE=altius

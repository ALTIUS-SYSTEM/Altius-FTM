# ---------------------------------------------------------------------------
# Altius FTM backend — example environment.
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# === Required: identity ===
KEYCLOAK_ISSUER=https://sso.example.com/realms/altius
# Must match the audience mapper on altius-web / altius-mobile (see deploy/keycloak).
KEYCLOAK_AUDIENCE=altius-api

# Optional overrides — defaults are derived from KEYCLOAK_ISSUER.
# Use these when the public issuer URL differs from internal container routes.
# KEYCLOAK_JWKS_URL=http://keycloak:8081/realms/altius/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=http://keycloak:8081/realms/altius/protocol/openid-connect/token

# === Persistence ===
# Backend selector: `postgres` (default, transactional source of truth) or
# `typedb` (**experimental** graph backend — not for production; requires TYPEDB_*).
STORE_BACKEND=postgres

# PostgreSQL — required when STORE_BACKEND=postgres.
# Local compose / private VPC: omit sslmode or use disable|prefer → cleartext NoTls.
# Production / managed Postgres: append ?sslmode=require (rustls + Mozilla CA roots).
# Example prod: postgres://user:pass@db.example.com:5432/altius?sslmode=require
DATABASE_URL=postgres://altius:altius@localhost:5432/altius
# DATABASE_URL=postgres://altius:altius@db.example.com:5432/altius?sslmode=require

# TypeDB — only required when STORE_BACKEND=typedb.
# TYPEDB_ADDRESS=localhost:1729
# TYPEDB_USERNAME=admin
# TYPEDB_PASSWORD=password
TYPEDB_DATABASE=altius

# === Bootstrap tenant (created on first start if absent) ===
DEFAULT_ORG_ID=altius
DEFAULT_ORG_NAME=Altius
DEFAULT_HUB_ID=jakarta
DEFAULT_HUB_NAME=Jakarta
DEFAULT_ADMIN_SUB=admin

# === Keycloak admin (user provisioning) ===
# Absent = user provisioning refuses. Fill to enable create/update/delete users.
# KEYCLOAK_ADMIN_CLIENT_ID=
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8081
# KEYCLOAK_ADMIN_REALM=altius

# === Resource-owner password grant ===
# Off unless explicitly enabled. Only safe behind a private, trusted frontend.
ALLOW_PASSWORD_GRANT=false

# === Optional integrations ===
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTE_MODE=directions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AGENT_STATE_SECRET=

# FCM v1 push — either project id (ADC) or a service account JSON path.
# FCM_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# SMS / WhatsApp gateway — absent token = notify endpoints refuse.
# NOTIFY_TOKEN=
# NOTIFY_SMS_URL=
# NOTIFY_WHATSAPP_URL=
# NOTIFY_SENDER=

# McEasy VSMS/TMS — absent API key = worker does not start.
# Docs: https://vsms-v2-public.mceasy.com/docs/
MCEASY_API_KEY=
MCEASY_BASE_URL=https://vsms-v2-public.mceasy.com
MCEASY_POLL_SECONDS=60
MCEASY_MASTER_SYNC_SECONDS=3600
MCEASY_RETENTION_HOURS=72

# Device-event retention (Postgres). Independent of McEasy GPS prune.
# Default 90 days; set 0 to disable the periodic DELETE on device_events.
EVENTS_RETENTION_DAYS=90

# === Server ===
BIND=127.0.0.1:8080
RUST_LOG=info
# `json` (default, for log shippers) or `text` (for a developer terminal).
LOG_FORMAT=json

# CORS — comma-separated browser origins; empty denies all cross-origin calls.
# CORS_ORIGINS=https://dashboard.example.com

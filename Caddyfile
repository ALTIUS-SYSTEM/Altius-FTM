# Altius FTM edge.
#
# Two site blocks: `:80` for local `docker compose up`, and the public domain
# for a VPS. Set ALTIUS_DOMAIN and Caddy provisions TLS automatically; leave it
# unset and only the local block answers.
#
# Rate limiting uses github.com/mholt/caddy-ratelimit, which is not in the
# stock image — see the `caddy` service in docker-compose.yml, which builds it
# in. Without that build the `rate_limit` directives below fail to parse, so
# keep the two in step.

{
	admin off
	servers {
		# Trust no forwarded client IPs by default; the rate limiter keys on
		# the peer address, and a spoofable X-Forwarded-For would let one
		# caller present as many.
		trusted_proxies static private_ranges
	}
	order rate_limit before reverse_proxy
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

(routes) {
	log {
		output stdout
		format json
	}

	# Edge liveness. Answered by Caddy itself, never proxied: a health probe
	# that depends on an upstream reports the edge as down whenever the app is
	# merely still starting.
	handle /healthz {
		respond "ok" 200
	}

	# Auth endpoints are the credential-stuffing surface: tighter bucket.
	handle /api/v3/auth/* {
		rate_limit {
			zone auth {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy api:8080
	}

	handle /api/v3/* {
		rate_limit {
			zone api {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy api:8080
	}

	handle /landing/* {
		uri strip_prefix /landing
		reverse_proxy landing:3000
	}

	handle /* {
		reverse_proxy web:3000
	}
}

# Local development / bare-IP deployment.
:80 {
	import routes
}

# Public deployment. Unset ALTIUS_DOMAIN and this block never matches.
{$ALTIUS_DOMAIN:localhost.invalid} {
	import security_headers
	import routes
}

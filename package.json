{
  "name": "altius-ftm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @altius/web dev",
    "dev:portal": "pnpm --filter @altius/developer-portal dev",
    "sync:portal-openapi": "pnpm --filter @altius/developer-portal sync:openapi",
    "dev:mobile": "cd apps/mobile && flutter run",
    "test:mobile": "cd apps/mobile && flutter test",
    "analyze:mobile": "cd apps/mobile && flutter analyze",
    "build": "pnpm --filter @altius/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @altius/web test:e2e",
    "qa:audit": "pnpm audit",
    "qa:outdated": "pnpm outdated -r"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}

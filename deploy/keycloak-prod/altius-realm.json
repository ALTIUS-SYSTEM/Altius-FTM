{
  "realm": "altius",
  "enabled": true,
  "displayName": "Altius",
  "sslRequired": "all",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "super-admin",
        "description": "Platform super admin"
      },
      {
        "name": "admin",
        "description": "Organization admin"
      },
      {
        "name": "supervisor",
        "description": "Hub supervisor"
      },
      {
        "name": "lead",
        "description": "Team lead"
      },
      {
        "name": "driver",
        "description": "Field driver"
      },
      {
        "name": "integration",
        "description": "Machine-to-machine service account (read allowlist)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "altius-api",
      "name": "Altius API resource",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "altius-web",
      "name": "Altius Web Dashboard",
      "enabled": true,
      "publicClient": true,
      "secret": "",
      "redirectUris": [
        "${ALTIUS_WEB_ORIGIN}/callback"
      ],
      "webOrigins": [
        "${ALTIUS_WEB_ORIGIN}"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ALTIUS_WEB_ORIGIN}"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-altius-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "altius-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "altius-mobile",
      "name": "Altius Field Mobile",
      "enabled": true,
      "publicClient": true,
      "secret": "",
      "redirectUris": [
        "com.altius.altiusfield:/oauthredirect"
      ],
      "webOrigins": [
        "+"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-altius-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "altius-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}

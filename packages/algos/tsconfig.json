  "compilerOptions": { "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "types": ["node"] },
  "include": ["src/**/*.ts", "src/**/*.json"]
